# Python bytecode + caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / packaging
build/
dist/
*.egg-info/
*.egg

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual envs (uv.lock is NOT ignored — keep it)
.venv/
venv/
env/

# Secrets — NEVER commit API keys
.env
.env.local
.env.*.local

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code project-local settings
.claude/

# mybot runtime data (only matters if MYBOT_DATA_ROOT points inside the repo)
.os-technician/
